{{- range .Schemas }}
  {{- range .Tables }}
public class {{ toCamel(.Name) }}DTO extends {{ toCamel(.Name) }} {
    {{- range .Columns }}
        {{- if .ForeignKey != "" }}
            {{- foreignTable:= split(.ForeignKey, ".")[0] }}
            {{- field := .Name }}
            {{- if hasSuffix(field, "_id") }}
                {{- field = replace(field, "_id", "", -1) }}
            {{- end }}
            {{- lowerCaseFT := toLowerCamel(foreignTable) }}
            {{- upperCaseFT := toCamel(foreignTable) }}
            {{- lowerCaseFD := toLowerCamel(field) }}
            {{- upperCaseFD := toCamel(field) }}
    private {{ upperCaseFT }}DTO {{ lowerCaseFD }}; // {{ .Name }}
        {{- end }}
    {{- end }}
    {{- range .References }}
        {{- col := .ColumnName }}
        {{- range .Foreign }}
    private List<{{ toCamel(.Table) }}DTO>
            {{- if col == .Column }}
                {{- " " + toPlural(toLowerCamel(.Table)) }};
            {{- else }}
                {{- " " + toPlural(toLowerCamel(.Table + "_" + replace(.Column, "_" + col, "", -1))) }};
            {{- end }}
        {{- end }}
    {{- end }}

    {* ----------------------------- set/get functions ---------------------------- *}
    {{- range .Columns }}
        {{- if .ForeignKey != "" }}
            {{- foreignTable := split(.ForeignKey, ".")[0] }}
            {{- field := .Name }}
            {{- if hasSuffix(field, "_id") }}
                {{- field = replace(field, "_id", "", -1) }}
            {{- end }}
            {{- lowerCaseFT := toLowerCamel(foreignTable) }}
            {{- upperCaseFT := toCamel(foreignTable) }}
            {{- lowerCaseFD := toLowerCamel(field) }}
            {{- upperCaseFD := toCamel(field) }}
    public {{ upperCaseFT }}DTO get{{ upperCaseFD }}() {
        return {{ lowerCaseFD }};
    }
    public void set{{ upperCaseFD }}({{ upperCaseFT }}DTO {{ lowerCaseFD }}) {
        this.{{ lowerCaseFD }} = {{ lowerCaseFD }};
    }
        {{- end }}
    {{- end }}
    {{- range .References }}
        {{- col := .ColumnName }}
        {{- range .Foreign }}
            {{- field := "" }}
            {{- if col == .Column }}
                {{- field = toPlural(toLowerCamel(.Table)) }}
            {{- else }}
                {{- field = toPlural(toLowerCamel(.Table + "_" + replace(.Column, "_" + col, "", -1))) }}
            {{- end }}
            {{- lowerCaseFT := toLowerCamel(field) }}
            {{- upperCaseFT := toCamel(field) }}
    public List<{{ toCamel(.Table) }}DTO> get{{ upperCaseFT }}() {
        return {{ lowerCaseFT }}
    }
    public void set{{ upperCaseFT }}(List<{{ toCamel(.Table) }}DTO> {{ lowerCaseFT }}) {
        this.{{ lowerCaseFT }} = {{ lowerCaseFT }};
    }
        {{- end }}
    {{- end }}
}
  {{- end }}
{{- end }}
