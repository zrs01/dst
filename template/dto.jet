{{- range .Schemas }}
  {{- range .Tables }}
public class {{ toCamel(.Name) }}DTO extends {{ toCamel(.Name) }} {
    {{- range .Columns }}
        {{- if .ForeignKey != "" }}
          {{- foreignTable:= split(.ForeignKey, ".")[0] }}
          {{- field := .Name }}
          {{- if hasSuffix(field, "_id") }}
            {{- field = replace(field, "_id", "", -1) }}
          {{- end }}
    private {{ toCamel(foreignTable) }}DTO {{ toLowerCamel(field) }}; // {{ .Name }}
        {{- end }}
    {{- end }}
    {{- range .References }}
        {{- col := .ColumnName }}
        {{- range .Foreign }}
    private List<{{ toCamel(.Table) }}DTO>
            {{- if col == .Column }}
                {{- " " + toPlural(toLowerCamel(.Table)) }};
            {{- else }}
                {{- " " + toPlural(toLowerCamel(.Table + "_" + replace(.Column, "_" + col, "", -1))) }};
            {{- end }}
        {{- end }}
    {{- end }}

    {* ----------------------------- set/get functions ---------------------------- *}
    {{- range .Columns }}
        {{- if .ForeignKey != "" }}
           {{- parts := split(.ForeignKey, ".") }}
           {{- lf := toLowerCamel(parts[0]) }}
           {{- uf := toCamel(parts[0]) }}
    public {{ uf }}DTO get{{ uf }}() {
        return {{ lf }};
    }
    public void set{{ uf }}({{ uf }}DTO {{ lf }}) {
        this.{{ lf }} = {{ lf }};
    }
        {{- end }}
    {{- end }}
    {{- range .References }}
        {{- col := .ColumnName }}
        {{- range .Foreign }}
            {{- field := "" }}
            {{- if col == .Column }}
                {{- field = toPlural(toLowerCamel(.Table)) }}
            {{- else }}
                {{- field = toPlural(toLowerCamel(.Table + "_" + replace(.Column, "_" + col, "", -1))) }}
            {{- end }}
            {{- lf := toLowerCamel(field) }}
            {{- uf := toCamel(field) }}
    public List<{{ toCamel(.Table) }}DTO> get{{ uf }}() {
        return {{ lf }}
    }
    public void set{{ uf }}(List<{{ toCamel(.Table) }}DTO> {{ lf }}) {
        this.{{ lf }} = {{ lf }};
    }
        {{- end }}
    {{- end }}
}
  {{- end }}
{{- end }}
