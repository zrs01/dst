import java.util.List;
{{ range .Schemas }}
  {{- range .Tables }}
public class {{ toCamel(.Name) }}DTO {
    {{- range .Columns }}
  private {{ toJavaType(.DataType) }} {{ toLowerCamel(.Name) }};
    {{- end }}
    {{- range .Columns }}
      {{- if .ForeignKey != "" }}
        {{- foreignItem := split(.ForeignKey, ".")}}
  private {{ toCamel(foreignItem[0]) }}DTO {{ toLowerCamel(replace(.Name, "_id", "", -1)) }};
      {{- end }}
    {{- end }}
    {{- range .References }}
        {{- cn := .ColumnName }}
        {{- range .Foreign }}
          {{- field := .Table }}
          {{- if cn != .Column }}
            {{- field = .Column }}
          {{- end }}
  private List<{{ toCamel(.Table) }}DTO> {{ toLowerCamel(replace(field, "_id", "", -1)) }};
        {{- end }}
    {{- end }}
    {* ----- Get/Set functions ----- *}
    {{- range .Columns }}
      {{- if .ForeignKey == "" }}
  public {{ toJavaType(.DataType) }} get{{ toCamel(.Name) }}() {
    return {{ toLowerCamel(.Name) }};
  }

  public void set{{ toCamel(.Name) }}({{ toJavaType(.DataType) }} {{ toLowerCamel(.Name) }}) {
    this.{{ toLowerCamel(.Name) }} = {{ toLowerCamel(.Name) }};
  }
      {{- end }}
    {{ end }}
    {{- range .Columns }}
      {{- if .ForeignKey != "" }}
        {{- foreignItem := split(.ForeignKey, ".")}}
        {{- foreignField := replace(.Name, "_id", "", -1) }}
  public {{ toCamel(foreignItem[0]) }}DTO get{{ toCamel(foreignField) }}() {
    return {{ toCamel(foreignField) }};
  }

  public void set{{ toCamel(foreignField) }}({{ toCamel(foreignField) }}DTO {{ toLowerCamel(foreignField) }}) {
    this.{{ toLowerCamel(foreignField) }} = {{ toLowerCamel(foreignField) }};
  }
      {{- end }}
    {{- end }}
    {{- range .References }}
      {{- cn := .ColumnName }}
      {{- range .Foreign }}
        {{- field := .Table }}
        {{- if cn != .Column }}
          {{- field = .Column }}
        {{- end }}
  public {{ toCamel(.Table) }}DTO get{{ toCamel(field) }}() {
    return {{ toCamel(field) }};
  }

  public void set{{ toCamel(field) }}({{ toCamel(.Table) }}DTO {{ toLowerCamel(field) }}) {
    this.{{ toLowerCamel(field) }} = {{ toLowerCamel(field) }};
  }
      {{ end }}
    {{- end }}
}
  {{- end }}
{{- end }}
