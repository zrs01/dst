{{- import "./mariadb-blocks.jet" }}
{{- range .Schemas }}
  {{- range .Tables }}
    {{- table := .Name }}
    {{- lastColumn := "" }}
    {{- range i := .Columns }}
ALTER TABLE {{ table }} ADD COLUMN IF NOT EXISTS {{ .Name }} {{ .DataType }}
      {{- if .Compute != "" }} AS ({{ .Compute }}){{ end }}
      {{- if .NotNull == "Y" }} NOT NULL {{- end }}
      {{- if .Value != "" }} DEFAULT '{{ .Value }}'{{ end }}
      {{- if .Desc != "" }} COMMENT '{{ .Desc }}'{{ end }}
      {{- if i != 0 }} AFTER {{ lastColumn }}{{ end }}
      {{- ";" }}
      {{- lastColumn = .Name }}
      {{- parts := split(.ForeignKey, ".") }}
      {{- if len(parts) > 1 }}
{{- yield createForeignKey(tableName=table, columnName=.Name, foreignTableName=parts[0], foreignColumnName=parts[1]) }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
