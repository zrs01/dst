{{- import "./mariadb-blocks.jet" }}
{* ----------------------------------- index ---------------------------------- *}
{{- range .Schemas }}
  {{- range .Tables }}
    {{- table := .Name }}
    {{- range .Columns }}
      {{- parts := split(.ForeignKey, ".") }}
      {{- if len(parts) > 1 || .Index == "Y" }}
{{- yield dropIndex(tableName=table, columnName=.Name) }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{* -------------------------------- foreign key ------------------------------- *}
{{- range .Schemas }}
  {{- range .Tables }}
    {{- table := .Name }}
    {{- range .Columns }}
      {{- parts := split(.ForeignKey, ".") }}
      {{- if len(parts) > 1 }}
{{- yield dropConstraint(tableName=table, columnName=.Name) }}
      {{- end }}
    {{- end }}
  {{ end }}
{{- end }}
{* ---------------------------------- tables ---------------------------------- *}
{{- range .Schemas }}
  {{- range .Tables }}
    {{- table := .Name }}
    {{- if .Version }}
ALTER TABLE IF EXISTS {{ .Name }} DROP SYSTEM VERSIONING;
    {{- end }}
DROP TABLE IF EXISTS {{ .Name }};
  {{- end }}
{{- end }}
