{{- import "./mariadb-blocks.jet" }}
{{- range .Schemas }}
  {{- range .Tables }}
    {{- table := .Name }}
    {{- range .Columns }}
      {{- parts := split(.ForeignKey, ".") }}
      {{- if len(parts) > 1 }}
{{- yield dropConstraint(tableName=table, columnName=.Name) }}
      {{- end }}
ALTER TABLE {{ table }} DROP COLUMN IF EXISTS {{ .Name }}
    {{- end }}
  {{- end }}
{{- end }}
